// QK4 confirms a managed install by reading FileDescription from <root>\QK4.exe. The string must not change.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "QK4 Update Launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "QK4"
            VALUE "OriginalFilename", "QK4.exe"
            VALUE "ProductName", "QK4"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
